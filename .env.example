# Server port
PORT=4000

# Storage: omit MONGODB_URI to run entirely in memory (no database needed).
# MONGODB_URI=mongodb://localhost:27017/lld-practice

# Reviewer model. Without a key the platform uses an offline stand-in reviewer
# so the full loop still works; the UI labels it clearly as simulated.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# auto | anthropic | offline | none
REVIEWER_MODE=auto

EVALUATION_CONCURRENCY=2
EVALUATION_RETRY_BASE_MS=1000
LLM_TIMEOUT_MS=45000
